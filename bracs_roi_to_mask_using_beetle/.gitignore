# The BRACS regions themselves: 665 PNGs, several GB, non-commercial licence, and
# fetched by resume_dcis.sh rather than committed.
data/dcis/

# Everything this app produces. Derived from BEETLE's weights and BRACS's images, so
# it inherits both non-commercial licences - see README. Regenerable in minutes.
data/runs/
data/sixslides/

# Images a user dropped on the fourth screen, and what the model made of them. Same
# licences, and additionally not ours: whatever somebody uploads to a local demo is
# theirs and has no business in this history.
data/uploads/

# Batch reports are regenerable too, but small and often worth keeping by hand. Ignore
# the default one only.
reports/batch.json

__pycache__/
*.pyc
.pytest_cache/
.venv/
