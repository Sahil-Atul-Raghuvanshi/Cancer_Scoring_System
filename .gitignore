# =========================================================================
#  Cancer Scoring System - what stays out of git
#
#  The sub-projects carry their own .gitignore for the artefacts they
#  generate. This file covers the whole tree and the things that are big,
#  regenerable, or not ours to redistribute.
#
#  Everything ignored here is put back by `python setup.py`.
# =========================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
dist/
.eslintcache
.env.local
*.local

# --- Model weights -------------------------------------------------------
# ~2.2 GB, and licence-encumbered: GrandQC is CC BY-NC, BEETLE is CC BY-NC-SA,
# and the trained tissue_type checkpoints inherit those terms through their
# training data. models.lock.json records the bytes and sha256 of each one and
# setup.py fetches and verifies them. The .manifest.json files beside the
# checkpoints ARE committed - see models/.gitignore.
*.pth
*.ckpt
*.pt
!**/*.manifest.json

# --- storage/: every byte that is not code ------------------------------
# One folder at the root, ignored whole. See STORAGE_VERSIONING.md.
#
#   storage/
#     data/                 SHARED by every version, read-only: original/ (BRACS,
#                           BACH, BCSS, the OncoStem slides and annotations - ~43 GB,
#                           nothing can regenerate them) and the client documents
#     v<N>_data/            ONE PER VERSION of the pipeline: data/ (what its runs
#                           produced), models/, results/, reports/, VERSION.md
#     decrecated_code/      retired code, kept on disk for the record, never run
#     ACTIVE_DATA_VERSION   the version the app shows, chosen in the web page
/storage/
# Bare `data/` stays ignored too: several sub-projects keep a local data/ folder.
data/
images/
uploads/



# --- Reference PDFs ------------------------------------------------------
# Two 162 MB scans of the same source document.
*.pdf

# --- Third-party checkout ------------------------------------------------
# Upstream GrandQC, cloned for reference rather than vendored. Not our code,
# and not needed once models/grandqc/ is populated.
#   python setup.py --clone-grandqc
grandqc/

# --- The isolated registration environment -------------------------------
# `.venv/` above already covers tissue_scoring_demo/valis_service/.venv, which
# is ~3 GB of VALIS, torch and numpy 1.x. These are its scratch directories:
# the probe/smoke/tuning runs write VALIS's own thumbnails, overlap images and
# registrar pickles (~270 MB per registered pair), all reproducible by
# re-running the scripts beside them. The scripts themselves are committed.
tissue_scoring_demo/valis_service/_smoke/
tissue_scoring_demo/valis_service/_real/
tissue_scoring_demo/valis_service/_tune/
tissue_scoring_demo/valis_service/_probe_jvm.json

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Superseded nested repository ----------------------------------------
# The Demo folder was its own repo before this tree became one. Its .git was
# renamed rather than deleted, so those 2 commits stay recoverable; it is not
# part of this history. Delete the directory once you are sure you want it gone.
.git.disabled-*/

# The H&E campaign's live state - a pid, a heartbeat and per-stage timings, rewritten
# every minute while `scripts/10_he_campaign.py` runs - now lives beside the per-stage
# logs it describes, in tissue_type_model_training/reports/he_campaign/, which that
# folder's own .gitignore already covers.
