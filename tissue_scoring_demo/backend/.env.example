# Application
APP_NAME="Breast Cancer IHC Tissue Scoring API"
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1

# CORS - comma separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Step 2: quality control -------------------------------------------
# All optional. Step 2 works with none of these set.

# Directory holding the GrandQC checkpoints, with td/ and qc/ inside. Leave
# unset to search <workspace>/models/grandqc and a sibling clone of the GrandQC repo.
# QC_MODELS_DIR=C:/models/grandqc

# Which artefact model to run, by the resolution it was trained at.
# 2.0 = 5x (fastest)   1.5 = 7x (recommended)   1.0 = 10x (most accurate)
QC_MODEL_MPP=1.5

# Refuse a run needing more forward passes than this, rather than occupying a
# worker for an hour.
QC_MAX_PATCHES=6000

# Read patches from level 0 like upstream GrandQC, instead of from the nearest
# at-or-finer pyramid level. Much slower, and only differs in resampling.
QC_READ_FROM_LEVEL_0=false
